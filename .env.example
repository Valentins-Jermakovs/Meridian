POSTGRES_HOST=meridian-postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=meridiandatabase

REDIS_HOST=meridian-redis
REDIS_PORT=6379
REDIS_DB=0
